# -- AgriSmart AI - example environment --
# Copy to `.env` and fill in real values locally. Never commit `.env`.
# All values below are placeholders.

# Deployment environment: development | staging | production
APP_ENV=development

# Backend API base URL consumed by the app layer
API_BASE_URL=http://localhost:8000

# Public API base URL for the web frontend (if applicable)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Model selection and inference
MODEL_NAME=
MODEL_PATH=
CONFIDENCE_THRESHOLD=0.6

# Upload limits
MAX_IMAGE_MB=8
